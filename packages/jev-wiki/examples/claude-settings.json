{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv-jev-wiki/bin/python\" -m jev_wiki --root \"$CLAUDE_PROJECT_DIR/.jev-wiki\" hook --project-root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv-jev-wiki/bin/python\" -m jev_wiki --root \"$CLAUDE_PROJECT_DIR/.jev-wiki\" hook --project-root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
